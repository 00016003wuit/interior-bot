# Telegram Bot Token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# FAL.ai API Key — get from https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# Anthropic API Key — used to validate uploaded photos contain a room/interior
# Get from https://console.anthropic.com/keys
# If not set, photo validation is skipped (not recommended for production)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port for the Express server
PORT=3000

# Your public HTTPS URL (required for Telegram Mini App and webhook)
# Development: use ngrok (https://abc123.ngrok.io)
# Production: your deployed URL (e.g. https://your-app.up.railway.app)
APP_URL=https://your-public-url-here
WEBHOOK_URL=https://your-public-url-here
